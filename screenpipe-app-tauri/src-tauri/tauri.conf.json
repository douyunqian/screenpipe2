{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screenpipe",
  "identifier": "screenpi.pe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
   "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      // 核心修改：禁用 MSI，启用 NSIS
      "installer": {
        "wix": {
          "enabled": false, // 禁用 MSI 安装器（解决报错的关键）
          "language": "en-US",
          "template": null,
          "componentGroupRefs": [],
          "featureGroupRefs": [],
          "componentRefs": [],
          "featureRefs": [],
          "extensions": [],
          "fragmentPaths": [],
          "skipDependencies": false
        },
        "nsis": {
          "enabled": true, // 启用 NSIS（生成 EXE 安装包）
          "language": "en-US",
          "artifactName": "${productName}-${version}-setup.${ext}",
          "installerIcon": "icons/icon.ico",
          "uninstallerIcon": "icons/icon.ico",
          "banner": null,
          "sidebar": null,
          "license": null,
          "oneClick": false,
          "perMachine": false,
          "allowElevation": true,
          "allowDowngrades": false,
          "shortcutDestination": "ProgramMenuFolder",
          "createDesktopShortcut": true,
          "createStartMenuShortcut": true
        }
      },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-black.png"
    ],
    "resources": [
      "assets/*"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://cdn.crabnebula.app/update/mediar/screenpipe/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyQjQ2RkQzMUNBOUFDMTcKUldRWHJLa2MwMiswSWl3RlBGUW5zYUE0Zm0vNFFRRTltNUZZTUVxR2FxUDNtSWdUSHgyL3JNcmcK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "screenpipe"
        ]
      },
      "mobile": [
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/auth"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/stripe-connect"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/purchase-successful"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/settings"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/changelog"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/onboarding"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/status"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "screenpipe",
        "width": 1200,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
